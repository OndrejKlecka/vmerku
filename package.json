{
  "name": "v-merku",
  "version": "0.1.0",
  "private": true,
  "description": "Hlídač akcí — sleduje slevy na vybrané produkty na Rohlíku a v letácích kamenných řetězců.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "db:seed": "tsx scripts/seed.ts",
    "check": "tsx scripts/run-check.ts",
    "worker": "tsx scripts/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:demo": "tsx scripts/demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "leaflet:dump": "tsx scripts/dump-leaflet.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:migrate": "wrangler d1 migrations apply vmerku --remote",
    "cf:secrets": "wrangler secret bulk",
    "cf:release": "npm run cf:migrate && npm run cf:build-info && wrangler deploy",
    "cf:build-info": "node scripts/build-info.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.136.2"
  }
}
