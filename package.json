{
  "name": "v-merku",
  "version": "0.1.0",
  "private": true,
  "description": "Hlídač akcí — sleduje slevy na vybrané produkty na Rohlíku a v letácích kamenných řetězců.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
