# Kde leží SQLite databáze (v Dockeru namapuj na perzistentní volume)
DATABASE_PATH=./data/v-merku.db

# SMTP pro odesílání notifikací. Bez těchto proměnných se e-maily jen logují do konzole.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hlídač akcí <hlidac@example.com>"

# Veřejná adresa appky – používá se v odkazech v e-mailu
APP_URL=http://localhost:3000

# Na hostingu s jedním kontejnerem (Render, Railway) spustí plánovač uvnitř
# appky. Na serveru s Dockerem nech vypnuté a použij worker z compose.yaml.
SCHEDULER_IN_PROCESS=0

# Volitelné: LLM normalizace názvů z PDF letáků (sekce 2.2 zadání). Bez klíče se přeskočí.
ANTHROPIC_API_KEY=
