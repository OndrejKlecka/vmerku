{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vmerku",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Appka běží v kontejneru; Worker je jen vrátný a plánovač.
  "containers": [
    {
      "class_name": "VmerkuContainer",
      "image": "./Dockerfile",
      // `basic` = 1 GiB paměti a 4 GB disku. Menší `dev` (256 MiB) na
      // rozebrání letáku nestačí.
      "instance_type": "basic",
      // Běží vždy jen jedna instance (worker ji volá pevným jménem). Druhé
      // místo je rezerva pro nasazení: nová verze může naběhnout, zatímco se
      // stará ještě vypíná, místo aby na ni čekala.
      "max_instances": 2
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "HLIDAC", "class_name": "VmerkuContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VmerkuContainer"] }],

  // Disk kontejneru je pomíjivý, takže data leží v D1.
  // `database_id` je z dashboardu (Storage & Databases → D1 → vmerku).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vmerku",
      "database_id": "9ed787bf-b676-4496-8a29-1d4979ee3aa2",
      // drizzle-kit sem generuje SQL; wrangler bere jen `*.sql`, podsložku
      // `meta/` ignoruje, takže obě nástroje žijí ve stejné složce.
      "migrations_dir": "drizzle"
    }
  ],

  // Časy jsou v UTC. V létě to vychází na 6:10 a 7:30 pražského času,
  // v zimě o hodinu dřív – kontrolám to nevadí.
  "triggers": {
    "crons": ["10 4 * * *", "30 5 * * 3,6"]
  },

  "vars": {
    "APP_URL": "https://vmerku.vandays.cz"
  },

  "observability": { "enabled": true }
}
